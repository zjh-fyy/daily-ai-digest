# ==================== 第一顺位：本地 Antigravity 网关 (Gemini 4 Hydrogen) ====================
# 仅本机可用（云端 Actions 自动跳过），夜间预生成时使用
LOCAL_LLM_API_KEY=
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8317/v1
# LOCAL_LLM_MODEL=gemini-4-hydrogen-xhigh

# ==================== 第二顺位：GPT-6.1-sol (/v1/responses 协议) ====================
# CODEX_API_KEY 与 AIZEX_API_KEY 至少填一个，两个都填则互为备份
CODEX_API_KEY=your_codex_api_key_here
# AIZEX_API_KEY=
# 自定义节点（可选，默认在 ca.memofun.net / codex-api.aizex.net 间自动轮换）
# CODEX_BASE_URL=
# 模型名称（默认 gpt-6.1-sol）
CODEX_MODEL=gpt-6.1-sol
# 思考深度（默认 high，可选 low / medium / high / xhigh）
CODEX_EFFORT=high

# ==================== 推送：邮件直推 + 微信「QQ邮箱提醒」 ====================
# 发件人邮箱（如 123456@qq.com，建议自己发给自己）
EMAIL_SENDER=
# 邮箱 SMTP 专属授权码（QQ邮箱：设置 -> 账户 -> POP3/IMAP/SMTP 服务 -> 生成授权码）
EMAIL_PASSWORD=
# 收件人邮箱（可选，留空则发送给 EMAIL_SENDER）
EMAIL_RECEIVER=
# 自定义 SMTP 服务器（可选，默认按邮箱后缀自动识别 smtp.qq.com:465 / smtp.163.com:465 等）
# SMTP_SERVER=smtp.qq.com:465

# ==================== GitHub（push_prebuilt.py 上传/拉取预生成早报用） ====================
# GITHUB_TOKEN=
